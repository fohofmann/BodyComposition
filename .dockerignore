# Ignore the .git directory
.git

# Ignore data, local notes, generated output, and all possible model caches.
data/
docs/
logs/
models/
**/*.dcm
**/*.DCM
**/*.ima
**/*.IMA
**/*.nii
**/*.nii.gz
**/*.nrrd
**/*.mha
**/*.mhd
**/*.parquet
**/models/
**/*.pth
**/*.pt
**/*.ckpt
**/*.onnx

# Ignore temporary files
*.log
*.tmp

# Ignore all .env files except .env.example
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
!.env.example

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore Mac-specific files
.DS_Store

# Ignore IDE/editor-specific files
.vscode/
.idea/

# Ignore build artifacts
build/
dist/
*.egg-info/
.attempts/
outputs/
output/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local automation state
