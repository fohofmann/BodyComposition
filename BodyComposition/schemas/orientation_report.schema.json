{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fohofmann/BodyComposition/schemas/orientation_report-1.1.0.json",
  "title": "BodyComposition orientation report",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "state",
    "execution_status",
    "qc_status",
    "manual_review_required",
    "orientation_changed",
    "severe_misorientation",
    "review_flags"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "PASS_METADATA_MATCH",
        "PASS_METADATA_UNCERTAIN",
        "MISMATCH_REPAIRED",
        "MISMATCH_UNCERTAIN",
        "HEADER_UNCERTAIN",
        "ORIENTATION_FAILED"
      ]
    },
    "execution_status": {"enum": ["succeeded", "failed"]},
    "qc_status": {"enum": ["pass", "review", "fail"]},
    "manual_review_required": {"type": "boolean"},
    "orientation_changed": {"type": "boolean"},
    "severe_misorientation": {"type": "boolean"},
    "original_orientation_code": {"type": "string", "minLength": 3, "maxLength": 3},
    "prepared_orientation_code": {"type": "string", "minLength": 3, "maxLength": 3},
    "direction_determinant": {"type": "number"},
    "residual_obliquity_deg": {"type": "number", "minimum": 0},
    "original_geometry": {"$ref": "#/$defs/geometry"},
    "prepared_geometry": {"$ref": "#/$defs/geometry"},
    "original_pixel_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_pixel_sha256": {"$ref": "#/$defs/sha256"},
    "original_affine_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_affine_sha256": {"$ref": "#/$defs/sha256"},
    "prediction": {"type": "object"},
    "body_extent_mm": {"type": "number", "minimum": 0},
    "metal_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "possible_fov_truncation": {"type": "boolean"},
    "prepared_input": {
      "type": "object",
      "required": ["kind", "relative_path"],
      "properties": {
        "kind": {"enum": ["original", "corrected_derivative"]},
        "relative_path": {"type": ["string", "null"]}
      }
    },
    "applied_transform": {"type": ["object", "null"]},
    "review_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "stage",
          "severity",
          "reason",
          "observed",
          "threshold",
          "suggested_action"
        ],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "stage": {"const": "orientation"},
          "severity": {"enum": ["low", "medium", "high"]},
          "reason": {"type": "string", "minLength": 1},
          "observed": {"type": "object"},
          "threshold": {"type": "object"},
          "suggested_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "required": [
        "asset_id",
        "name",
        "required_for",
        "upstream_project",
        "upstream_repository",
        "upstream_commit",
        "download_url",
        "byte_size",
        "expected_files",
        "code_license",
        "weight_license_status",
        "redistribution_mode",
        "compatibility",
        "validation_set_version",
        "citation_doi",
        "checkpoint_sha256",
        "metadata_discrete_direction_lps"
      ],
      "properties": {
        "asset_id": {
          "const": "ctdeeprot-2d-492114b8f9f3a7f058d4e97c0dd3643fb8d39649"
        },
        "name": {"const": "CTDeepRot-2D"},
        "required_for": {"const": "default_orientation_integrity_stage"},
        "upstream_project": {"const": "CTDeepRot"},
        "upstream_repository": {
          "const": "https://github.com/JakubicekRoman/CTDeepRot"
        },
        "upstream_commit": {
          "const": "492114b8f9f3a7f058d4e97c0dd3643fb8d39649"
        },
        "download_url": {
          "const": "https://raw.githubusercontent.com/JakubicekRoman/CTDeepRot/492114b8f9f3a7f058d4e97c0dd3643fb8d39649/python/example_prediction/models/net2d.pt"
        },
        "byte_size": {"const": 44890653},
        "expected_files": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "required": ["relative_path", "byte_size", "sha256"],
              "properties": {
                "relative_path": {"const": "net2d.pt"},
                "byte_size": {"const": 44890653},
                "sha256": {
                  "const": "a2feb521cfe49c367c4e594f38fa76ba9982ba009e114fbf15fb2aae06c06d96"
                }
              },
              "additionalProperties": false
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        "code_license": {"const": "BSD-3-Clause"},
        "weight_license_status": {
          "const": "published_in_bsd_3_clause_repository_without_separate_checkpoint_terms;redistribution_not_assumed"
        },
        "redistribution_mode": {"const": "user_model_sync"},
        "compatibility": {
          "type": "object",
          "required": [
            "architecture",
            "input_shape_chw",
            "simpleitk_array_boundary"
          ],
          "properties": {
            "architecture": {
              "const": "torchvision.resnet18_conv1_9_channels_fc_24_classes"
            },
            "input_shape_chw": {
              "const": [9, 224, 224]
            },
            "simpleitk_array_boundary": {
              "const": "array_zyx_to_model_array_yxz"
            }
          },
          "additionalProperties": false
        },
        "validation_set_version": {
          "const": "ct-org-140-cads-eee3c0a993636264fd04104f7e2a090c507c0c43-orientation-v1"
        },
        "citation_doi": {
          "const": "https://doi.org/10.1007/978-3-030-64610-3_7"
        },
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_discrete_direction_lps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "integer", "minimum": -1, "maximum": 1}
          }
        }
      },
      "additionalProperties": false
    },
    "error_type": {"type": "string"},
    "error_summary": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"const": "succeeded"}}},
      "then": {
        "required": [
          "original_orientation_code",
          "prepared_orientation_code",
          "original_geometry",
          "prepared_geometry",
          "prediction",
          "body_extent_mm",
          "prepared_input",
          "model"
        ]
      }
    },
    {
      "if": {"properties": {"orientation_changed": {"const": true}}},
      "then": {
        "properties": {
          "state": {"const": "MISMATCH_REPAIRED"},
          "manual_review_required": {"const": true},
          "qc_status": {"const": "review"},
          "applied_transform": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geometry": {
      "type": "object",
      "required": ["size_xyz", "spacing_xyz", "origin_lps_xyz", "direction_lps"],
      "properties": {
        "size_xyz": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "spacing_xyz": {"type": "array", "minItems": 3, "maxItems": 3},
        "origin_lps_xyz": {"type": "array", "minItems": 3, "maxItems": 3},
        "direction_lps": {"type": "array", "minItems": 9, "maxItems": 9}
      }
    }
  }
}
