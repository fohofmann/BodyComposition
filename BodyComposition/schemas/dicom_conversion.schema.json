{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fohofmann/BodyComposition/schemas/dicom_conversion.schema.json",
  "title": "BodyComposition DICOM conversion metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sidecar_type", "nifti", "source_dicom"],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.2.0", "1.3.0", "1.4.0", "1.5.0"]}
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "source_dicom": {
            "properties": {
              "dicom": {
                "required": [
                  "discovered_instance_count",
                  "excluded_instance_count",
                  "instance_selection",
                  "excluded_instance_content_sha256"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.4.0", "1.5.0"]}
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "source_dicom": {
            "properties": {
              "dicom": {
                "required": [
                  "selection",
                  "acquisition_date",
                  "study_date",
                  "series_date",
                  "content_date",
                  "series_number",
                  "acquisition_number",
                  "study_instance_uid_sha256",
                  "frame_of_reference_uid_sha256",
                  "sop_instance_uid_sha256",
                  "image_type_values",
                  "convolution_kernel",
                  "kvp",
                  "pixel_spacing_row_column_mm",
                  "spacing_between_slices_mm",
                  "reconstruction_diameter_mm",
                  "rescale_intercept",
                  "rescale_slope",
                  "gantry_detector_tilt_degrees"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.5.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["conversion_created_at"],
        "properties": {
          "source_dicom": {
            "properties": {
              "dicom": {
                "required": [
                  "acquisition_datetime",
                  "instance_creation_date",
                  "instance_creation_time",
                  "series_description",
                  "protocol_name",
                  "study_description",
                  "body_part_examined",
                  "patient_position",
                  "contrast_bolus_agent",
                  "contrast_bolus_route",
                  "contrast_bolus_volume_ml",
                  "exposure_time_ms",
                  "xray_tube_current_ma",
                  "exposure_mas"
                ],
                "properties": {
                  "selection": {
                    "required": ["header_repairs"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_xyz", "spacing_xyz", "origin_lps_xyz", "direction_lps"],
      "properties": {
        "size_xyz": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false
        },
        "spacing_xyz": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        },
        "origin_lps_xyz": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        },
        "direction_lps": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        }
      }
    },
    "qualityRank": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "maximum": -1},
        {"type": "integer", "minimum": 2}
      ],
      "items": false
    },
    "stackMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_count",
        "coverage_mm",
        "slice_spacing_mm",
        "axial_alignment",
        "quality_rank"
      ],
      "properties": {
        "instance_count": {"type": "integer", "minimum": 2},
        "coverage_mm": {"type": "number", "exclusiveMinimum": 0},
        "slice_spacing_mm": {"type": "number", "exclusiveMinimum": 0},
        "axial_alignment": {
          "type": "number",
          "minimum": 0.98,
          "maximum": 1
        },
        "quality_rank": {"$ref": "#/$defs/qualityRank"}
      }
    },
    "stackCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_instance_uid_sha256",
        "acquisition_number",
        "instance_count",
        "coverage_mm",
        "slice_spacing_mm",
        "axial_alignment",
        "quality_rank"
      ],
      "properties": {
        "series_instance_uid_sha256": {"$ref": "#/$defs/sha256"},
        "acquisition_number": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "instance_count": {"type": "integer", "minimum": 2},
        "coverage_mm": {"type": "number", "exclusiveMinimum": 0},
        "slice_spacing_mm": {"type": "number", "exclusiveMinimum": 0},
        "axial_alignment": {
          "type": "number",
          "minimum": 0.98,
          "maximum": 1
        },
        "quality_rank": {"$ref": "#/$defs/qualityRank"}
      }
    },
    "headerRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary", "observed_range", "applied_value"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observed_range": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"}
              ],
              "items": false
            },
            {"type": "null"}
          ]
        },
        "applied_value": {
          "oneOf": [
            {"type": "number"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            },
            {"type": "null"}
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_strategy",
        "acquisition_strategy",
        "evaluated_ct_series_count",
        "eligible_stack_count",
        "manual_review_recommended",
        "selected_metrics",
        "eligible_candidates",
        "rejected_candidates"
      ],
      "properties": {
        "series_strategy": {
          "enum": [
            "single-ct-series",
            "explicit-series-instance-uid",
            "automatic-best-series"
          ]
        },
        "acquisition_strategy": {
          "enum": [
            "whole-series",
            "automatic-best-acquisition",
            "explicit-acquisition-number"
          ]
        },
        "evaluated_ct_series_count": {
          "type": "integer",
          "minimum": 1
        },
        "eligible_stack_count": {
          "type": "integer",
          "minimum": 1
        },
        "manual_review_recommended": {"type": "boolean"},
        "selected_metrics": {"$ref": "#/$defs/stackMetrics"},
        "header_repairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/headerRepair"}
        },
        "eligible_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stackCandidate"}
        },
        "rejected_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "series_instance_uid_sha256",
              "code",
              "summary"
            ],
            "properties": {
              "series_instance_uid_sha256": {"$ref": "#/$defs/sha256"},
              "acquisition_number": {
                "type": ["string", "null"],
                "maxLength": 80
              },
              "code": {"type": "string", "minLength": 1},
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "dicom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_instance_uid_sha256",
        "instance_count",
        "modality",
        "scanner_manufacturer",
        "scanner_model",
        "slice_thickness_mm",
        "image_orientation_patient_complete",
        "image_position_patient_complete",
        "conversion_backend",
        "conversion_backend_version"
      ],
      "properties": {
        "series_instance_uid_sha256": {"$ref": "#/$defs/sha256"},
        "instance_count": {"type": "integer", "minimum": 1},
        "discovered_instance_count": {"type": "integer", "minimum": 1},
        "excluded_instance_count": {"type": "integer", "minimum": 0},
        "instance_selection": {
          "enum": [
            "all-series-instances",
            "exclude-single-orthogonal-localizer",
            "exclude-tagged-accessory-instances",
            "automatic-best-axial-stack",
            "explicit-acquisition-number"
          ]
        },
        "excluded_instance_content_sha256": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"}
        },
        "selection": {"$ref": "#/$defs/selection"},
        "modality": {"const": "CT"},
        "scanner_manufacturer": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "scanner_model": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "slice_thickness_mm": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "acquisition_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "acquisition_datetime": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "study_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "series_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "content_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "instance_creation_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "instance_creation_time": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "series_number": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "acquisition_number": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "series_description": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "protocol_name": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "study_description": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "body_part_examined": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "patient_position": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "contrast_bolus_agent": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "contrast_bolus_route": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "contrast_bolus_volume_ml": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "study_instance_uid_sha256": {"$ref": "#/$defs/nullableSha256"},
        "frame_of_reference_uid_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "sop_instance_uid_sha256": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/sha256"}
            },
            {"type": "null"}
          ]
        },
        "image_type_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "convolution_kernel": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "kvp": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "pixel_spacing_row_column_mm": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "number", "exclusiveMinimum": 0}
              ],
              "items": false
            },
            {"type": "null"}
          ]
        },
        "spacing_between_slices_mm": {
          "type": ["number", "null"]
        },
        "reconstruction_diameter_mm": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "rescale_intercept": {"type": ["number", "null"]},
        "rescale_slope": {"type": ["number", "null"]},
        "gantry_detector_tilt_degrees": {
          "type": ["number", "null"]
        },
        "exposure_time_ms": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "xray_tube_current_ma": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "exposure_mas": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "image_orientation_patient_complete": {"type": "boolean"},
        "image_position_patient_complete": {"type": "boolean"},
        "conversion_backend": {
          "type": "string",
          "minLength": 1
        },
        "conversion_backend_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0"]
    },
    "sidecar_type": {"const": "bodycomposition-dicom-conversion"},
    "conversion_created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "nifti": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "byte_size", "pixel_sha256", "geometry"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1},
        "pixel_sha256": {"$ref": "#/$defs/sha256"},
        "geometry": {"$ref": "#/$defs/geometry"}
      }
    },
    "source_dicom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "byte_size", "dicom"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1},
        "dicom": {"$ref": "#/$defs/dicom"}
      }
    }
  }
}
