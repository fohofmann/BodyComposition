{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodycomposition.local/schemas/report_case_input.schema.json",
  "title": "BodyComposition post-hoc case-report input",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "prepared_ct",
    "tissue_label_mask",
    "vertebral_body_mask",
    "vertebral_result_json",
    "measurement_directory",
    "orientation_report_json",
    "measurement_qc_json"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "prepared_ct": {"type": "string", "minLength": 1},
    "tissue_label_mask": {"type": "string", "minLength": 1},
    "vertebral_body_mask": {"type": "string", "minLength": 1},
    "vertebral_result_json": {"type": "string", "minLength": 1},
    "measurement_directory": {"type": "string", "minLength": 1},
    "orientation_report_json": {"type": "string", "minLength": 1},
    "measurement_qc_json": {"type": "string", "minLength": 1},
    "patient_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patient_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 96},
        "date_of_birth": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scan_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sex": {"enum": ["F", "M", "O", "U", null]}
      }
    },
    "technical_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_started_at": {"type": ["string", "null"], "maxLength": 160},
        "data_attribution": {"type": ["string", "null"], "maxLength": 160},
        "input_format": {"enum": ["dicom", "nifti", "unknown", null]},
        "pipeline_version": {"type": ["string", "null"], "maxLength": 160},
        "runtime_backend": {"type": ["string", "null"], "maxLength": 160},
        "runtime_hardware": {"type": ["string", "null"], "maxLength": 160},
        "scanner_manufacturer": {"type": ["string", "null"], "maxLength": 160},
        "scanner_model": {"type": ["string", "null"], "maxLength": 160},
        "dicom_slice_thickness_mm": {"type": ["string", "null"], "maxLength": 160}
      }
    }
  },
  "additionalProperties": false
}
