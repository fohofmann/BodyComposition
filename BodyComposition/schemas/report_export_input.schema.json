{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodycomposition.local/schemas/report_export_input.schema.json",
  "title": "BodyComposition ordered report export input",
  "type": "object",
  "required": ["export_id", "cases"],
  "properties": {
    "export_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_manifest"],
        "properties": {
          "case_manifest": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
