{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodycomposition.local/schemas/report_manifest.schema.json",
  "title": "BodyComposition report manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "report_id",
    "layout",
    "page_size",
    "page_count",
    "render_status",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "manifest_type": {"enum": ["case", "export"]},
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "layout": {"enum": ["spine_overview_v1", "spine_profile_v2"]},
    "page_size": {"const": "A4_landscape"},
    "page_count": {"type": "integer", "minimum": 1},
    "render_status": {
      "enum": ["succeeded", "succeeded_with_warnings", "failed_page_generated"]
    },
    "manual_review_required": {"type": "boolean"},
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "analysis_id": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "renderer": {"type": "object"},
    "review_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "domain",
          "code",
          "reason",
          "automatic_action",
          "review_status"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "domain": {
            "enum": ["orientation", "vertebral", "measurement", "pipeline", "reporting"]
          },
          "code": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "automatic_action": {"type": "string", "minLength": 1},
          "review_status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "cases": {"type": "array", "minItems": 1},
    "cover_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "page_number", "summary", "audit"],
      "properties": {
        "included": {"const": true},
        "page_number": {"const": 1},
        "summary": {"type": "object"},
        "audit": {"type": "object"}
      }
    },
    "manual_review_summary": {"type": "object"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "snapshot_id", "pointer"],
      "properties": {
        "strategy": {"const": "atomic_snapshot_pointer_v1"},
        "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pointer": {"const": ".current"}
      }
    },
    "pdf_file": {"const": "case_report.pdf"},
    "combined_pdf_file": {"const": "case_reports.pdf"},
    "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "combined_pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_type": {"const": "case"}}},
      "then": {
        "required": [
          "case_id",
          "analysis_id",
          "configuration",
          "renderer",
          "review_entries",
          "warnings",
          "pdf_file",
          "pdf_sha256"
        ]
      }
    },
    {
      "if": {"properties": {"manifest_type": {"const": "export"}}},
      "then": {
        "required": [
          "export_id",
          "configuration",
          "renderer",
          "cover_page",
          "manual_review_summary",
          "combined_pdf_file",
          "combined_pdf_sha256",
          "cases"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "manifest_type": {"const": "case"},
          "render_status": {"enum": ["succeeded", "succeeded_with_warnings"]}
        }
      },
      "then": {"required": ["source_artifacts", "display"]}
    }
  ],
  "additionalProperties": true
}
