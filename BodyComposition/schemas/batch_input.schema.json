{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fohofmann/BodyComposition/schemas/batch_input.schema.json",
  "title": "BodyComposition ordered batch input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_path"],
        "properties": {
          "input_path": {"type": "string", "minLength": 1},
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "series_uid": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
          }
        }
      }
    }
  }
}
